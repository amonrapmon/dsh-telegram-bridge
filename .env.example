DSH_TELEGRAM_TOKEN=
# Numeric user IDs, separated by commas; empty means deny all.
DSH_TELEGRAM_ALLOWED_USER_IDS=
# Numeric group/supergroup chat IDs; empty means private chats only.
DSH_TELEGRAM_ALLOWED_GROUP_CHAT_IDS=
# Select explicitly when Harness has multiple workspaces.
DSH_TELEGRAM_WORKSPACE_ID=
DSH_TELEGRAM_REQUIRE_MENTION=true
# Defaults to $DSH_HOME/telegram-bridge-state.json
DSH_TELEGRAM_STATE_FILE=
